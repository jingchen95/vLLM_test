    },
    "fast_safety": {
      "telemetry_max_age_s": 1.0,
      "hard_ttft_trigger_ms": 600.0,
      "hard_tpot_trigger_ms": 65.0,
      "risk_fraction_trigger": null
    },
    "context_inference": {
      "long_input_tokens": 512,
      "long_output_tokens": 256,
      "prefill_heavy_fraction": 0.75,
