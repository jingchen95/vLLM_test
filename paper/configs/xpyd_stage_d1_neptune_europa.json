    ],
    "slo_regime": "TIGHT",
    "slo": {"ttft_ms": 600.0, "tpot_ms": 65.0, "attainment": 0.95},
    "max_concurrency": 4,
    "routing": "fixed RR for comparators; runtime-feedback full-pair routing for JOINT",
    "frequency_state": "independent per endpoint",
    "cold_start": "all endpoints HIGH for every full policy/load/repeat block",
    "predictor": false,
    "offline_profile": false,
    "rl": false,
    "bandit": false,
    "tp2": false,
    "frequency_levels_mhz": {
      "P0": {"LOW": 1260, "MID": 1890, "HIGH": 2520},
      "P1": {"LOW": 1260, "MID": 1890, "HIGH": 2520},
      "D0": {"LOW": 750, "MID": 1125, "HIGH": 1500},
      "D1": {"LOW": 750, "MID": 1125, "HIGH": 1500}
    },
    "load_points": [
      {"id": "MEDIUM", "scenario": "stationary_medium", "offered_rate_rps": 0.10},
      {"id": "HIGH-SUSTAINABLE", "scenario": "stationary_high_sustainable", "offered_rate_rps": 0.20}
    ],
    "preflight_load_point": "HIGH-SUSTAINABLE",
    "preflight_warmup_windows": 1,
    "preflight_warmup_semantics": "declared all-HIGH startup warm-up; excluded from controller and fixed-asymmetry evidence",
    "preflight_windows": 3,
    "windows_per_block": 5,
    "repetitions": 3,
    "minimum_dwell_s": 1.0,
    "adaptive_exploration": {
      "min_valid_requests": 8,
      "min_input_tokens": 1024,
      "min_output_tokens": 1024,
      "min_observation_duration_s": 1.0,
      "max_evidence_timeout_s": 120.0,
      "telemetry_max_age_s": 300.0,
      "headroom_for_one_step": 0.01,
      "headroom_for_large_jump": 0.10,
      "large_jump_levels": 2,
      "context_invalidation_on_change": true,
