    "short_input_max_tokens": 512,
    "short_output_max_tokens": 256
  },
  "shapes": {
    "SS": {"input_len": 128, "output_len": 128},
    "SL": {"input_len": 128, "output_len": 512},
    "LS": {"input_len": 2048, "output_len": 128},
    "LL": {"input_len": 2048, "output_len": 512}
  },
  "control_window_s": 200.0,
  "scenarios": [
    {
      "id": "stationary_medium",
      "segments": [{
        "id": "steady_mix", "request_count": 20, "rate_rps": 0.10,
        "class_weights": {"SS": 0.35, "SL": 0.15, "LS": 0.35, "LL": 0.15}
      }]
    },
    {
      "id": "stationary_high_sustainable",
      "segments": [{
        "id": "steady_mix", "request_count": 20, "rate_rps": 0.20,
        "class_weights": {"SS": 0.35, "SL": 0.15, "LS": 0.35, "LL": 0.15}
      }]
    }
  ],
  "stage_d1": {
